# Copy to .env and fill in. Never commit .env.

# Elastic Cloud Serverless project (https://ela.st/calhacks)
ELASTICSEARCH_URL=https://<project>.es.<region>.elastic.cloud
KIBANA_URL=https://<project>.kb.<region>.elastic.cloud
# Encoded API key, used for both Elasticsearch and the Kibana Agent Builder API
ELASTIC_API_KEY=

# Jina (https://jina.ai/api-dashboard): embeddings + reranker endpoints, and Reader for research pages
JINA_API_KEY=

# Optional: use an Elastic-hosted Jina endpoint instead of creating one from JINA_API_KEY.
# Leave empty to create `jina-embeddings` and `jina-rerank` endpoints.
ELASTIC_EMBEDDING_INFERENCE_ID=
ELASTIC_RERANK_INFERENCE_ID=
