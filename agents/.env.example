# Copy to agents/.env. The seed fixes the agent's address on Agentverse: keep it secret, and share it only with teammates who run the agent.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SHOPPER_SEED=

# Optional: ASI:One API key (https://asi1.ai) so the agent reads requests with the ASI:One model.
# Without it, the agent uses its keyword rules. ASI_ONE_MODEL defaults to asi1-mini.
ASI_ONE_API_KEY=
